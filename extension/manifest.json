{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "__MSG_short__",
  "version": "1.84.1",
  "version_name": "1.84.1 beta",
  "description": "__MSG_desc__",
  "homepage_url": "https://owlook-quotes.github.io/owlook/",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "notifications",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_action__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "indicators.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "__MSG_cmd__"
    }
  },
  "default_locale": "en",
  "side_panel": {
    "default_path": "panel.html"
  }
}
